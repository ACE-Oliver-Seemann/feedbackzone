// Data model per docs/requirements/mvp.md, section "Dátový model" (nine tables).
//
// NFR-01: Response has NO user column and NO timestamp. Who answered is stored
// only in Participation. The initial migration additionally declares Response
// and Participation as WITHOUT ROWID (so insertion order cannot be recovered
// from SQLite's hidden rowid) and adds CHECK constraints. Prisma cannot express
// either, so they live in prisma/migrations/*_init/migration.sql.
// If a later migration redefines these tables, re-add both by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               String // EMPLOYEE | MANAGER | HR
  // Set at logout: session tokens issued before this moment are no longer
  // accepted, so a copied cookie stops working (MVP-01, QA BE-001).
  sessionsValidAfter DateTime?
  teamId             String?
  team               Team?     @relation("TeamMembers", fields: [teamId], references: [id])

  managedTeam    Team?           @relation("TeamManager")
  participations Participation[]
  kudosSent      Kudos[]         @relation("KudosFrom")
  notesWritten   MeetingNote[]
  issuesCreated  Issue[]
  issuesAssigned Issue[]         @relation("IssueAssignee")
  issuesRelated  Issue[]         @relation("IssueRelatedUser")
  issueComments  IssueComment[]
  kudosReceived  Kudos[]         @relation("KudosTo")
}

model Team {
  id        String @id @default(cuid())
  name      String
  managerId String @unique
  manager   User   @relation("TeamManager", fields: [managerId], references: [id])

  members   User[]     @relation("TeamMembers")
  questions Question[]
  issues    Issue[]
  rounds    Round[]
  responses Response[]
}

model Question {
  id      String  @id @default(cuid())
  text    String
  type    String  @default("SCALE_1_5")
  topic   String
  // Which labels the five points carry; keys are in src/config/scales.ts (IT-03).
  scale   String  @default("AGREEMENT")
  // Recommended starting set, highlighted when a round is created (IT-03).
  starter Boolean @default(false)
  // Null = shared library. Otherwise the question was written by the manager of
  // this team and only this team may use it (IT-07).
  teamId  String?
  team    Team?   @relation(fields: [teamId], references: [id])
  // Trend question: added automatically as the first question of every round (IT-04).
  fixed   Boolean @default(false)

  rounds RoundQuestion[]

  // One wording per team (QA BE-005). SQLite treats NULL team ids as distinct,
  // so this does not constrain the shared library.
  @@unique([teamId, text])
}

model Round {
  id       String    @id @default(cuid())
  teamId   String
  team     Team      @relation(fields: [teamId], references: [id])
  name     String
  startsAt DateTime? // set when the round is opened
  closesAt DateTime
  closedAt DateTime? // when it was actually closed; used for reaction time (IT-05)
  status   String    @default("DRAFT") // DRAFT | OPEN | CLOSED

  questions      RoundQuestion[]
  participations Participation[]
  responses      Response[]
  actions        Action[]
  issues         Issue[]
}

model RoundQuestion {
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  position   Int // 1..5, maps to Response.v1..v5

  @@id([roundId, position])
  @@unique([roundId, questionId])
}

// Only the fact that a user answered. No content, no timestamp (NFR-01).
model Participation {
  roundId String
  round   Round  @relation(fields: [roundId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@id([roundId, userId])
}

// No user, no timestamp, UUID id (NFR-01). v1..v5 follow RoundQuestion.position.
model Response {
  id      String  @id @default(uuid())
  roundId String
  round   Round   @relation(fields: [roundId], references: [id])
  teamId  String
  team    Team    @relation(fields: [teamId], references: [id])
  v1      Int
  v2      Int
  v3      Int
  v4      Int?
  v5      Int?
  comment String?

  @@index([roundId])
}

model Action {
  id          String   @id @default(cuid())
  roundId     String
  round       Round    @relation(fields: [roundId], references: [id])
  topic       String
  description String
  dueDate     DateTime
  status      String   @default("PLANNED") // PLANNED | IN_PROGRESS | DONE
  // Actions are written by the manager and are not confidential, so they may
  // carry a timestamp. Response and Participation must never get one (NFR-01).
  createdAt   DateTime @default(now())
}

model Kudos {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("KudosFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("KudosTo", fields: [toUserId], references: [id])
  text       String
  value      String
  visibility String // TEAM | PRIVATE
  // Optional emoji from KUDOS_EMOJIS; with it the text may be empty (IT-06).
  emoji      String?
  createdAt  DateTime @default(now())
}

// HR's note from an offline meeting; typed text only (IT-10). HR only.
model MeetingNote {
  id          String   @id @default(cuid())
  title       String
  meetingDate DateTime
  text        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  issues Issue[]
}

// Something HR wants solved, assigned to an owner group (IT-10). Since IT-14
// also a "responsibility": it may have a responsible person (assignee), who
// sees it, and a related employee, who does not. Managers create their own.
// May point to a round and a team, never to a Response (NFR-01).
model Issue {
  id            String         @id @default(cuid())
  title         String
  description   String         @default("")
  source        String // SURVEY | MEETING | OTHER
  ownerGroup    String // keys in src/config/owner-groups.ts
  status        String         @default("OPEN") // OPEN | IN_PROGRESS | WAITING | DONE
  priority      String         @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT (IT-14)
  dueDate       DateTime?
  completedAt   DateTime? // set when the status becomes DONE (IT-14)
  roundId       String?
  round         Round?         @relation(fields: [roundId], references: [id])
  teamId        String?
  team          Team?          @relation(fields: [teamId], references: [id])
  noteId        String?
  note          MeetingNote?   @relation(fields: [noteId], references: [id])
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])
  assigneeId    String?
  assignee      User?          @relation("IssueAssignee", fields: [assigneeId], references: [id])
  relatedUserId String?
  relatedUser   User?          @relation("IssueRelatedUser", fields: [relatedUserId], references: [id])
  createdAt     DateTime       @default(now())
  comments      IssueComment[]

  @@index([assigneeId])
}

// Progress update on an issue (IT-14). `internal` = HR only.
model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([issueId])
}
